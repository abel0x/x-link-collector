{
  "manifest_version": 3,
  "name": "X Link Collector",
  "version": "1.0.0",
  "description": "Files x.com / twitter.com status links into a local links.txt and closes the tab.",
  "homepage_url": "https://github.com/abel0x/x-link-collector",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:9876/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Link Collector - click to check the receiver",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "minimum_chrome_version": "102"
}
