# Per-user service: install with `make service`, or by hand into
# ~/.config/systemd/user/ followed by
#   systemctl --user daemon-reload && systemctl --user enable --now x-link-receiver

[Unit]
Description=X link collector receiver (127.0.0.1:9876)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/x-link-receiver
Restart=on-failure
RestartSec=2

# Uncomment to override where links are written; by default the receiver
# resolves your localised desktop directory from ~/.config/user-dirs.dirs.
#Environment=LINKS_FILE=%h/links.txt

# The daemon reads one config file, appends to one text file and listens on
# loopback. Nothing else needs to be reachable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
